PORT=3000
SESSION_SECRET=change-me-to-a-random-string

# Local models (Ollama) - no API key, free, run on your machine.
# Leave these unset on a hosted deployment (e.g. Render) with no Ollama
# server available -- OpenRouter below takes over automatically.
OLLAMA_BASE_URL=http://localhost:11434
# `ollama pull qwen2.5-coder:7b` then set this to enable the local coding route.
LOCAL_CODING_MODEL=
# `ollama pull qwen2.5:7b` then set this to enable every other local category
# (general, creative, summarization, classification, translation, fast).
LOCAL_GENERAL_MODEL=

# OpenRouter (free-tier cloud models) - used automatically when the
# corresponding LOCAL_*_MODEL above isn't set, or a local call fails.
# Get a free key at https://openrouter.ai/keys (free-tier models need no
# billing, just an account). Free-tier model availability changes often and
# claims found online (blogs, search results) go stale fast -- verify live
# with:
#   curl -s https://openrouter.ai/api/v1/models | jq -r \
#     '.data[] | select(.pricing.prompt=="0" and .pricing.completion=="0") | .id'
# Verified working live on 2026-09-15:
OPENROUTER_API_KEY=
OPENROUTER_CODING_MODEL=cohere/north-mini-code:free
# openrouter/free is OpenRouter's own auto-router across free models --
# more resilient than pinning one slug, since it adapts as the free lineup
# changes.
OPENROUTER_GENERAL_MODEL=openrouter/free
OPENROUTER_SITE_URL=

# Optional extra free-tier fallback (tried last). Tencent's Hy3 was reported
# free in some 2026 coverage, but was NOT in the live free-models list when
# checked on 2026-09-15 (its real slug requires payment) -- left unset by
# default. Re-check the list above before enabling:
# OPENROUTER_HY3_MODEL=tencent/hy3:free
