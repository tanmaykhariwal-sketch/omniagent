PORT=3000
SESSION_SECRET=change-me-to-a-random-string

# Local models (Ollama) - no API key, free, run on your machine. This app is
# local-only: there is no cloud fallback.
OLLAMA_BASE_URL=http://localhost:11434
# `ollama pull qwen2.5-coder:7b` then set this to enable the coding route.
LOCAL_CODING_MODEL=
# `ollama pull qwen2.5:7b` then set this to enable every other category
# (general, creative, summarization, classification, fast).
LOCAL_GENERAL_MODEL=
